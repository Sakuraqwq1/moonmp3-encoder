// moonmp3-encoder — pure MoonBit MP3 encoder.
// Documentation: https://docs.moonbitlang.com/en/latest/toolchain/moon/module.html

name = "Sakuraqwq1/moonmp3-encoder"

version = "0.2.2"

readme = "README.md"

repository = "https://github.com/Sakuraqwq1/moonmp3-encoder"

license = "Apache-2.0"

keywords = [
  "mp3",
  "audio",
  "codec",
  "encoder",
  "mpeg",
  "layer3",
  "mdct",
  "huffman",
  "pcm",
]

description = "Pure MoonBit MPEG-1 Layer III encoder: 44.1 kHz mono/stereo, 128 kbps CBR, polyphase filterbank and MDCT, scalefactor bands, Huffman coding, zero FFI; 27.6-32.7 dB SNR on synthetic probes."
