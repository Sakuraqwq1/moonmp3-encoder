// moonmp3-encoder — pure MoonBit MP3 encoder.
// Documentation: https://docs.moonbitlang.com/en/latest/toolchain/moon/module.html

name = "Sakuraqwq1/moonmp3-encoder"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/Sakuraqwq1/moonmp3-encoder"

license = "Apache-2.0"

keywords = [
  "mp3",
  "audio",
  "codec",
  "encoder",
  "mpeg",
  "layer3",
  "mdct",
  "huffman",
  "pcm",
]

description = "Pure MoonBit MP3 encoder: turn interleaved PCM into an MPEG-1 Layer III stream with MDCT transform, Huffman coding and a bit reservoir."
